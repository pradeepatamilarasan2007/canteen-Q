# CanteenQ Configuration

# ========================================================
# 1. SMS Gateway Configuration (Twilio - Server-Side Only)
# ========================================================
# Sign up at https://www.twilio.com and get these from your Twilio Console:
# Note: Keep these secret! They are only accessed server-side by server.js.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# (Optional) Twilio Messaging Service SID (if using a Messaging Service instead of a single number)
# TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid

# Default international country code prefix for 10-digit mobile numbers (default: +91 for India)
DEFAULT_COUNTRY_CODE=+91

# ========================================================
# 2. Server Port (for Express API & static hosting)
# ========================================================
PORT=5000

# ========================================================
# 3. Optional Firebase Configuration
# ========================================================
# If these are left blank or omitted, CanteenQ automatically runs in
# zero-configuration Demo Mode using persistent local storage + real-time sync.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
