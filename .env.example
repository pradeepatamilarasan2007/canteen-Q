# CanteenQ Firebase Configuration
# If these environment variables are left blank or omitted, CanteenQ automatically runs in
# clearly-labelled, zero-configuration Demo Mode using persistent local storage + real-time event sync.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server Port (for Express API & static hosting)
PORT=5000
